PORT=3000
DB_HOST=your-aiven-host.a.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=defaultdb
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Use DB_SSL_CA on Vercel. Paste the full ca.pem content with \n line breaks.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Use DB_SSL_CA_PATH for local file-based development only:
# DB_SSL_CA_PATH=/absolute/path/to/ca.pem
